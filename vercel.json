{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/_/backend/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "experimentalServices": {
    "frontend": {
      "root": "frontend",
      "routePrefix": "/",
      "framework": "angular"
    },
    "backend": {
      "root": "backend",
      "routePrefix": "/_/backend",
      "framework": "node",
      "entrypoint": "src/server.ts"
    }
  }
}