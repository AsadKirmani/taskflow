{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/v1/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "experimentalServices": {
    "frontend": {
      "root": "frontend",
      "routePrefix": "/",
      "framework": "angular"
    },
    "backend": {
      "root": "backend",
      "routePrefix": "/api/v1",
      "framework": "node",
      "entrypoint": "src/server.ts"
    }
  }
}